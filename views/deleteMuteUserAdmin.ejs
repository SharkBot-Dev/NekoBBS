<script>
    const muteUserId = `<%= muteUserId %>`
    
    async function deleteMuteUser() {
        const response = await fetch(`/api/admin/user/mute?authorId=` + muteUserId, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        if (!response.ok) {
            alert(`ミュート解除に失敗しました！ status: ${response.status}`)
        } else {
            alert("ミュートを解除しました。")
            location.href = "/bbs/admin/mute"
        }
    }

    const result = window.confirm(muteUserId + 'のミュートを解除してもよろしいですか？');
    if (result) {
        deleteMuteUser();
    } else [
        location.href = "/bbs/admin/mute"
    ]
</script>  