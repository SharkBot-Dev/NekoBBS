
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/style.css">
    <title><%= title %> - BBSホーム</title>
</head>
<body>
    <h1><%= title %> - BBSホームへようこそ！</h1>

    <div class="threadBox">
        <h3 id="username"></h3>
        <div class="container" id="loginButtons">
            <button id="logout">ログアウト</button>
        </div>
    </div>

    <h3>スレッドを作る</h3>
    <div class="threadBox">
        <input id="threadName" placeholder="スレッド名">
        <button id="createThread">スレッドを作成</button>
    </div>

    <br/>
    <h3>スレッド一覧</h3>
    <div class="threadBox">
        <div id="threads"></div>
    </div>

    <script>
        async function loadUser() {
            const response = await fetch("/api/users/me");

            if (!response.ok) {
                location.href = "/";
                return;
            }

            const data = await response.json();

            document.getElementById("username")
                .textContent = data.user.name + "さん、よろしく！";

            if (data.user.admin) {
                const adminMuteButton = document.createElement("button");
                adminMuteButton.textContent = "管理パネル"
                
                adminMuteButton.addEventListener("click", () => {
                    location.href = "/bbs/admin/mute"
                })

                document.getElementById("loginButtons").appendChild(adminMuteButton)
            }

            // document.getElementById("discordId")
            //     .textContent =
            //         "Discord ID: " + (data.discord?.id ?? "未連携");

            // if (data.user.image) {
            //     document.getElementById("avatar").src =
            //         data.user.image;
            // }
        }

        async function loadThreads() {
            const response = await fetch("/api/threads/list");

            if (!response.ok) {
                alert("スレッドが読み込めませんでした。")
                return;
            }

            const data = await response.json();

            if (data.threads) {
                const threads = document.getElementById("threads");

                let threadsText = ""
                for (const t of data.threads) {
                    threadsText += `<a href='/bbs/threads?t=${t.id}'>${t.title}</a><br/>`
                }

                threads.innerHTML = threadsText
            }
        }

        document.getElementById("logout")
            .addEventListener("click", async () => {
                const response = await fetch(
                    "/api/auth/sign-out",
                    { method: "POST" }
                );

                if (response.ok) {
                    location.href = "/";
                }
            });

        document.getElementById("createThread")
            .addEventListener("click", async () => {
                const thradName = document.getElementById("threadName").value;
                if (!thradName) {
                    alert("スレッド名を指定する必要があります。")
                    return
                }
                
                const response = await fetch(
                    "/api/threads/create",
                    { 
                        method: "POST", 
                        body: JSON.stringify({
                            title: thradName
                        }),
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    }
                );

                if (response.ok) {
                    const thread = await response.json();

                    alert("スレッドを作成しました。")
                    location.href = "/bbs/threads?t=" + thread.thread.id;
                }
            });

        loadUser();
        loadThreads();
    </script>
</body>
</html>
