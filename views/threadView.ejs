
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/style.css">
    <title><%= title %></title>
</head>
<body>
    <h1><%= threadName %></h1>

    <a href="/bbs">←戻る</a><br/>
    
    <div id="posts"></div>

    <div class="threadBox">
        <h5 id="username"></h5>
        <textarea id="content" placeholder="投稿内容" class="content"></textarea><br/>
        <button id="post">投稿する</button>
    </div>

    <script>
        async function loadUser() {
            const response = await fetch("/api/users/me");

            if (!response.ok) {
                location.href = "/";
                return;
            }

            const data = await response.json();

            document.getElementById("username")
                .textContent = data.user.name + "として投稿します。";

            // document.getElementById("discordId")
            //     .textContent =
            //         "Discord ID: " + (data.discord?.id ?? "未連携");

            // if (data.user.image) {
            //     document.getElementById("avatar").src =
            //         data.user.image;
            // }
        }

        async function loadPosts() {
            const url = new URL(location.href)
            const urlParams = new URLSearchParams(url.search);
            if (!urlParams.get('t')) {
                alert("レスが読み込めませんでした。")
                return;
            }

            const response = await fetch("/api/posts/list?t=" + urlParams.get('t'));

            if (!response.ok) {
                alert("レスが読み込めませんでした。")
                return;
            }

            const data = await response.json();

            if (data.posts) {
                const posts = document.getElementById("posts");

                let postsText = ""
                for (const p of data.posts) {
                    postsText += `<div class="post"><div class="author">${p.count}. ${p.authorName} (${p.authorId})</div><br>${p.content}</div><br/>`
                }

                posts.innerHTML = postsText
            }
        }

        document.getElementById("post")
            .addEventListener("click", async () => {
                const url = new URL(location.href)
                const urlParams = new URLSearchParams(url.search);
                if (!urlParams.get('t')) {
                    alert("レスが読み込めませんでした。")
                    return;
                }

                const content = document.getElementById("content").value;
                if (!content) {
                    alert("スレッド名を指定する必要があります。")
                    return
                }
                
                const response = await fetch(
                    "/api/posts/create",
                    { 
                        method: "POST", 
                        body: JSON.stringify({
                            content: content,
                            threadId: urlParams.get('t')
                        }),
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    }
                );

                if (response.ok) {
                    location.reload();
                } else {
                    alert("投稿失敗！")
                }
            });

        loadUser();
        loadPosts();
    </script>
</body>
</html>
